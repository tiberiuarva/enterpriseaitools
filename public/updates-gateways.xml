    <id>https://www.enterpriseai.tools/updates/#update-2026-10-21-10</id>
    <title>Cloudflare AI provider packages deprecated for createAI</title>
    <updated>2026-10-21T00:00:00.000Z</updated>
    <link href="https://www.enterpriseai.tools/updates/#update-2026-10-21-10" />

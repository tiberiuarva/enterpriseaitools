# Site URL used for canonical links and OG metadata.
# Set to your production domain. Defaults to https://enterpriseai.tools
# NEXT_PUBLIC_SITE_URL=https://enterpriseai.tools

# Base path prefix for the static export.
# Set to empty string for root deployment, or a path like /enterpriseai-tools
# for subdirectory hosting. Defaults to empty string (root deployment).
# Example subdirectory value: /enterpriseai-tools
# NEXT_PUBLIC_BASE_PATH=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Inlined into the client bundle at build time, so it is public by nature —
# but it is environment-specific, so it is set as a GitHub Actions repository
# variable rather than committed. See DEPLOYMENT.md.
# Leave unset to build with no analytics and no consent banner.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
